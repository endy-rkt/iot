Vagrant.configure("2") do |config|
  # box os
  config.vm.box = "generic/alpine318"
  config.vm.box_version = "4.3.12"

  #sync shared folder
  config.vm.synced_folder "./conf", "/vagrant"

  # provider hardware
  config.vm.provider "virtualbox" do |vb|
    vb.memory = 2048
    vb.cpus = 2
  end

  # server machine
  config.vm.define "trazanadS" do |trazanadS|
    trazanadS.vm.hostname = "trazanadS"
    trazanadS.vm.network "private_network", ip: "192.168.56.110"

    trazanadS.vm.provision "install-dependancy", type: "shell", path: "./scripts/install-dep.sh" 
  
    # Reload VM
    trazanadS.vm.provision :reload

    #setup-k3s
    trazanadS.vm.provision "setup-k3s", type: "shell", path: "./scripts/setup-k3s-server.sh"

    #deploy apps
    trazanadS.vm.provision "deploy-apps", type: "shell", path: "./scripts/deploy.sh"

  end

end
